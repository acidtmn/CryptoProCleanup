#include <windows.h>
#include "version.hpp"

#define IDI_APP_ICON 201
IDI_APP_ICON ICON "../assets/CryptoProCleanup.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CPC_VERSION_NUMERIC
 PRODUCTVERSION CPC_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kirill Alexandrov"
            VALUE "FileDescription", "CryptoPro Cleanup Resume Helper"
            VALUE "FileVersion", CPC_VERSION_TEXT
            VALUE "InternalName", "CryptoProCleanupResume"
            VALUE "LegalCopyright", "Copyright (c) Kirill Alexandrov"
            VALUE "OriginalFilename", "CryptoProCleanupResume.exe"
            VALUE "ProductName", "CryptoPro Cleanup Utility"
            VALUE "ProductVersion", CPC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
