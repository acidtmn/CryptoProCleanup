#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_MAIN DIALOGEX 0, 0, 760, 610
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "CryptoPro Cleanup Utility"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "CryptoPro Cleanup Utility", IDC_TITLE, 12, 10, 520, 18, SS_LEFT
    COMBOBOX        IDC_LANGUAGE, 666, 8, 80, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Unofficial open-source utility. Not affiliated with Crypto-Pro LLC.", IDC_DISCLAIMER, 12, 29, 734, 20, SS_LEFT
    CONTROL         "", IDC_TAB, WC_TABCONTROL, WS_TABSTOP, 10, 52, 740, 440

    LTEXT           "Detected products", IDC_PRODUCTS_LABEL, 22, 80, 716, 12
    CONTROL         "", IDC_PRODUCTS, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 22, 94, 716, 118
    LTEXT           "User profiles", IDC_PROFILES_LABEL, 22, 218, 716, 12
    CONTROL         "", IDC_PROFILES, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 22, 232, 716, 78
    CONTROL         "Select all", IDC_SELECT_ALL_PROFILES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 314, 170, 14
    LTEXT           "Backup folder", IDC_BACKUP_LABEL, 22, 336, 100, 12
    EDITTEXT        IDC_BACKUP_PATH, 124, 333, 522, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_BROWSE, 652, 333, 86, 18
    LTEXT           "", IDC_BACKUP_INFO, 22, 357, 716, 40, SS_LEFT
    PUSHBUTTON      "Show / copy license", IDC_SHOW_LICENSES, 22, 426, 180, 22
    PUSHBUTTON      "Scan", IDC_SCAN, 474, 426, 92, 22
    DEFPUSHBUTTON   "Remove selected", IDC_CLEAN, 572, 426, 166, 22

    LTEXT           "", IDC_CERT_INFO, 22, 80, 716, 25, SS_LEFT
    CONTROL         "", IDC_CERTIFICATES, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 22, 110, 716, 277
    CONTROL         "Select all certificates", IDC_SELECT_ALL_CERTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 394, 190, 14
    PUSHBUTTON      "Export selected public certificates...", IDC_EXPORT_CERTS, 458, 418, 280, 24

    LTEXT           "", IDC_OFFLINE_INFO, 22, 80, 716, 30, SS_LEFT
    LTEXT           "Windows folder", IDC_OFFLINE_PATH_LABEL, 22, 118, 90, 12
    EDITTEXT        IDC_OFFLINE_PATH, 114, 115, 442, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_OFFLINE_BROWSE, 562, 115, 82, 18
    PUSHBUTTON      "Scan", IDC_OFFLINE_SCAN, 650, 115, 88, 18
    LTEXT           "Detected offline products", IDC_OFFLINE_PRODUCTS_LABEL, 22, 141, 716, 12
    CONTROL         "", IDC_OFFLINE_PRODUCTS, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 22, 155, 716, 90
    LTEXT           "Public certificates in offline profiles", IDC_OFFLINE_CERTS_LABEL, 22, 251, 716, 12
    CONTROL         "", IDC_OFFLINE_CERTS, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 22, 265, 716, 108
    CONTROL         "Select all certificates", IDC_OFFLINE_SELECT_ALL_CERTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 379, 190, 14
    PUSHBUTTON      "Show / copy licenses", IDC_OFFLINE_SHOW_LICENSES, 22, 414, 176, 24
    PUSHBUTTON      "Save rescued data...", IDC_OFFLINE_SAVE, 364, 414, 180, 24
    PUSHBUTTON      "Advanced offline cleanup...", IDC_OFFLINE_CLEAN, 550, 414, 188, 24

    CONTROL         "<a href=""https://github.com/acidtmn/CryptoProCleanup"">GitHub</a>", IDC_LINK_GITHUB, WC_LINK, WS_TABSTOP, 10, 498, 132, 15
    CONTROL         "<a href=""https://kodalexandrova.ru"">Code Alexandrov website</a>", IDC_LINK_WEBSITE, WC_LINK, WS_TABSTOP, 150, 498, 220, 15
    CONTROL         "<a href=""https://yoomoney.ru/to/4100119195083142"">Support the project</a>", IDC_LINK_SUPPORT, WC_LINK, WS_TABSTOP, 390, 498, 220, 15
    CONTROL         "", IDC_PROGRESS, PROGRESS_CLASS, PBS_SMOOTH, 10, 521, 740, 10
    LTEXT           "Ready", IDC_STATUS, 10, 535, 740, 13
    EDITTEXT        IDC_LOG, 10, 550, 740, 48, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER
END

IDD_LICENSES DIALOGEX 0, 0, 470, 278
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MAXIMIZEBOX
CAPTION "CryptoPro licenses"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_LICENSES_WARNING, 10, 9, 450, 31, SS_LEFT
    EDITTEXT        IDC_LICENSES_TEXT, 10, 43, 450, 198, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Copy all", IDC_COPY_LICENSES, 280, 250, 88, 18
    DEFPUSHBUTTON   "Close", IDOK, 374, 250, 86, 18
END

IDD_TYPED_CONFIRM DIALOGEX 0, 0, 360, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Additional confirmation"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_CONFIRM_TEXT, 10, 10, 340, 34
    EDITTEXT        IDC_CONFIRM_EDIT, 10, 48, 340, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 194, 76, 75, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 275, 76, 75, 18
END
