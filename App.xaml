            <!-- 0.5.3 spacing system. Cards use one semantic style so their
                 content never depends on ad-hoc margins for an inner inset. -->
            <x:Double x:Key="Space4">4</x:Double>
            <x:Double x:Key="Space8">8</x:Double>
            <x:Double x:Key="Space12">12</x:Double>
            <x:Double x:Key="Space16">16</x:Double>
            <x:Double x:Key="Space20">20</x:Double>
            <x:Double x:Key="Space24">24</x:Double>
            <x:Double x:Key="Space32">32</x:Double>
            <Thickness x:Key="CardPadding">20</Thickness>
            <Thickness x:Key="CompactCardPadding">16</Thickness>
            <Thickness x:Key="StatCardPadding">16,14</Thickness>
            <Thickness x:Key="CalloutPadding">14</Thickness>
            <Thickness x:Key="DialogContentPadding">20,12,20,4</Thickness>
            <Thickness x:Key="TableHeaderPadding">18,16,18,12</Thickness>
            <Thickness x:Key="TableRowPadding">16,12</Thickness>
            <Thickness x:Key="TableFooterPadding">16,12</Thickness>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="ButtonLabelStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="CardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
            <Style x:Key="ContentCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
            </Style>
            <Style x:Key="CompactContentCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="{StaticResource CompactCardPadding}"/>
            </Style>
            <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="{StaticResource StatCardPadding}"/>
                <Setter Property="MinHeight" Value="92"/>
            </Style>
            <Style x:Key="TableCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="CalloutCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="{StaticResource CalloutPadding}"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <Style x:Key="NavigationSafetyCardStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}">
                <Setter Property="Padding" Value="{StaticResource CalloutPadding}"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            <!-- Compatibility alias for runtime-created chrome only. Authored
                 content cards must use a semantic style above. -->
            <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardChromeStyle}"/>
            <Style x:Key="RoundedButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Background" Value="{ThemeResource SecondaryButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryButtonForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}"/>
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource PrimaryButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryButtonForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBorderBrush}"/>
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource InverseTextBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource DangerBorderBrush}"/>
            </Style>
            <Style x:Key="CompactNavigationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="{ThemeResource NavigationBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource NavigationBackgroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource InputForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style TargetType="HyperlinkButton">
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}"/>
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="Background" Value="{ThemeResource NavigationBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
